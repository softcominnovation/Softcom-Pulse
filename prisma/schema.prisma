generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model MonitoredResourceConfig {
  id               String   @id @default(uuid()) @db.Uuid
  resourceType     String   @map("resource_type") @db.VarChar(32)
  source           String   @default("zabbix") @db.VarChar(16)
  zabbixHostKey    String   @map("zabbix_host_key") @db.VarChar(256)
  selectorType     String?  @map("selector_type") @db.VarChar(32)
  selectorValue    String?  @map("selector_value") @db.VarChar(256)
  displayName      String?  @map("display_name") @db.VarChar(120)
  description      String?  @db.VarChar(240)
  serviceType      String?  @map("service_type") @db.VarChar(40)
  dashboardEnabled Boolean @default(false) @map("dashboard_enabled")
  critical         Boolean @default(false)
  displayOrder     Int      @default(0) @map("display_order")
  presentation     Json     @default("{}")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([displayOrder, id])
  @@map("monitored_resource_config")
}

model PulseSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pulse_settings")
}

model VmDisplayConfig {
  vmKey              String   @id @map("vm_key") @db.VarChar(35)
  hostKey            String   @map("host_key") @db.VarChar(256)
  vmId               String   @map("vm_id") @db.VarChar(64)
  virtualizationType String   @map("virtualization_type") @db.VarChar(8)
  originalName       String   @map("original_name") @db.VarChar(512)
  displayName        String?  @map("display_name") @db.VarChar(120)
  revision           Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([hostKey, virtualizationType, vmId])
  @@map("vm_display_config")
}

model ExternalService {
  id                 String   @id @default(uuid()) @db.Uuid
  displayName        String   @map("display_name") @db.VarChar(120)
  description        String?  @db.VarChar(240)
  serviceType        String?  @map("service_type") @db.VarChar(40)
  enabled            Boolean  @default(true)
  dashboardEnabled   Boolean  @default(false) @map("dashboard_enabled")
  critical           Boolean  @default(false)
  displayOrder       Int      @default(0) @map("display_order")
  revision           Int      @default(1)
  method             String   @db.VarChar(8)
  url                String   @db.VarChar(2048)
  successMode        String   @map("success_mode") @db.VarChar(16)
  expectedStatuses   Int[]    @default([200]) @map("expected_statuses")
  jsonPointer        String?  @map("json_pointer") @db.VarChar(80)
  expectedValue      String?  @map("expected_value") @db.VarChar(80)
  bodyTemplate       String?  @map("body_template") @db.VarChar(2048)
  authMode           String   @map("auth_mode") @db.VarChar(16)
  headerName         String?  @map("header_name") @db.VarChar(40)
  secretCiphertext   String?  @map("secret_ciphertext")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  samples            ExternalServiceSample[]

  @@index([displayOrder, id])
  @@map("external_service")
}

model ExternalServiceSample {
  id         BigInt          @id @default(autoincrement())
  serviceId  String          @map("service_id") @db.Uuid
  service    ExternalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  checkedAt  DateTime        @map("checked_at") @db.Timestamptz(3)
  reason     Int             @db.SmallInt
  latencyMs  Int?            @map("latency_ms")
  httpStatus Int?            @map("http_status") @db.SmallInt

  @@index([serviceId, checkedAt])
  @@map("external_service_sample")
}

model VmTemplateConfig {
  templateKey        String   @id @map("template_key") @db.VarChar(35)
  hostKey            String   @map("host_key") @db.VarChar(256)
  templateId         String   @map("template_id") @db.VarChar(64)
  virtualizationType String   @map("virtualization_type") @db.VarChar(8)
  originalName       String   @map("original_name") @db.VarChar(512)
  displayName        String?  @map("display_name") @db.VarChar(120)
  roleOverride       String?  @map("role_override") @db.VarChar(16)
  revision           Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([hostKey, virtualizationType, templateId])
  @@map("vm_template_config")
}
