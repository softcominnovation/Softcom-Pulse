generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model MonitoredResourceConfig {
  id               String   @id @default(uuid()) @db.Uuid
  resourceType     String   @map("resource_type") @db.VarChar(32)
  source           String   @default("zabbix") @db.VarChar(16)
  zabbixHostKey    String   @map("zabbix_host_key") @db.VarChar(256)
  selectorType     String?  @map("selector_type") @db.VarChar(32)
  selectorValue    String?  @map("selector_value") @db.VarChar(256)
  displayName      String?  @map("display_name") @db.VarChar(120)
  dashboardEnabled Boolean @default(false) @map("dashboard_enabled")
  critical         Boolean @default(false)
  displayOrder     Int      @default(0) @map("display_order")
  presentation     Json     @default("{}")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([displayOrder, id])
  @@map("monitored_resource_config")
}

model PulseSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("pulse_settings")
}
