# Copy to .env and fill in. Do not commit .env.
# The app reads complete URLs. URL-encode special characters in credentials.
# POSTGRES_PASSWORD and POSTGRES_PASSWORD_DEV belong to the Portainer stacks.
# The local Node process uses DATABASE_URL and REDIS_URL.

DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/pulse"
REDIS_URL="redis://127.0.0.1:6379"

# Authentication API. The app falls back to this same URL when the variable is absent.
API_BASE_URL="https://api.softcom.cloud"
# Required: 32 random bytes encoded as base64; server-only, unique per environment.
TOKEN_ENCRYPTION_KEY=

ZABBIX_API_URL=
ZABBIX_API_TOKEN=

# Integer from 15000 to 30000.
COLLECTOR_INTERVAL_MS=20000
# SNAPSHOT_STALE_AFTER_MS must be at least twice the collector interval and below this TTL in milliseconds.
SNAPSHOT_TTL_SECONDS=300
SNAPSHOT_STALE_AFTER_MS=60000
# Absent or empty means 60000. A present value must be an integer from 30000 to 120000.
PROBE_INTERVAL_MS=60000
VPS_MONITOR_INTERVAL_MS=60000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PASSWORD_DEV=
POSTGRES_DB=pulse

NEXT_PUBLIC_APP_NAME="Softcom Pulse"
NEXT_PUBLIC_SOFTCOM_URL="https://www.softcomtecnologia.com.br"
