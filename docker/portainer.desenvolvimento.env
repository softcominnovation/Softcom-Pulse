# Stack de desenvolvimento. Segredos ficam vazios até o preenchimento no Portainer.
# PULSE_VERSION é a tag da imagem. Troque só este valor para atualizar web, collector, sonda e monitor.

PULSE_VERSION=dev
# DATABASE_URL usa o host pulse_postgres_dev, banco pulse e a senha de POSTGRES_PASSWORD_DEV com percent-encoding.

DATABASE_URL=
REDIS_URL=redis://pulse_redis_dev:6379
API_BASE_URL=https://api.softcom.cloud
# E-mails que gravam, separados por vírgula. Vazio recusa toda gravação. Só o serviço web lê.
PULSE_EDITOR_EMAILS=
TOKEN_ENCRYPTION_KEY=
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
COLLECTOR_INTERVAL_MS=20000
SNAPSHOT_TTL_SECONDS=300
SNAPSHOT_STALE_AFTER_MS=60000
PROBE_INTERVAL_MS=60000
VPS_MONITOR_INTERVAL_MS=60000
NEXT_PUBLIC_APP_NAME=Softcom Pulse
NEXT_PUBLIC_SOFTCOM_URL=https://www.softcomtecnologia.com.br
POSTGRES_USER=postgres
POSTGRES_DB=pulse
POSTGRES_PASSWORD_DEV=
